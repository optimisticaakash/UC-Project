# Client Environment Configuration (.env.example)

# Backend API Base URL
# In local development, defaults automatically to http://localhost:5001 (or http://127.0.0.1:5001).
# For production deployments, set to your deployed backend origin without a trailing slash.
VITE_API_URL=http://localhost:5001

# Backend Wait Announcement Delay in Milliseconds (Optional, defaults to 3000 ms, min: 500 ms)
# Time to wait before triggering audio thinking/processing announcements during slow turns.
VITE_BACKEND_WAIT_ANNOUNCEMENT_MS=3000
