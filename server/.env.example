# Server Environment Configuration (.env.example)

# Runtime Environment (development | production | test)
NODE_ENV=development

# Server Port (Optional, default: 5001)
PORT=5001

# Persistent Storage (Required)
# MongoDB connection URI (e.g. MongoDB Atlas cluster or local MongoDB instance)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority

# CORS Configuration
# Allowed frontend origin in production (in development, localhost and 127.0.0.1 origins are allowed automatically)
ADMIN_ALLOWED_ORIGIN=http://localhost:5173

# Admin Setup Token (Required for initial first-admin creation)
# Must be a secure random token at least 32 characters long (e.g. generated via `openssl rand -hex 32`)
ADMIN_SETUP_TOKEN=your_secure_random_admin_setup_token_at_least_32_characters

# Google Gemini AI Integration (Required for AI interview, answer interpretation, and voice features)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Gemini Model Selection (Optional, defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Gemini Request Timeouts in Milliseconds (Optional, defaults to 15000 ms)
GEMINI_INTERPRETATION_TIMEOUT_MS=15000
GEMINI_INQUIRY_TIMEOUT_MS=15000

# Legacy Admin Credentials (Optional migration fallback if no admin exists in MongoDB)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_legacy_password

# Google Sheets Synchronization (Optional)
# If unset, interview data is safely stored in MongoDB only.
GOOGLE_SHEET_ID=your_google_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_RSA_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
