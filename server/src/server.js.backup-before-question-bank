const express = require("express");
const cors = require("cors");
require("dotenv").config();

const app = express();

app.use(cors());
app.use(express.json());

app.get("/api/health", (req, res) => {
  res.json({
    success: true,
    message: "Urban Company Interviewer API is running",
  });
});


const questions = [
  {
    id: 1,
    text: "Namaste! Aap apna introduction dijiye aur apne salon experience ke baare mein batayein.",
    category: "introduction",
  },
  {
    id: 2,
    text: "Agar koi customer aapki service se khush nahi hai, toh aap unki complaint kaise handle karengi?",
    category: "customer_handling",
  },
  {
    id: 3,
    text: "Service shuru karne se pehle aap customer ki requirements aur preferences kaise confirm karengi?",
    category: "communication",
  },
];

const sessions = new Map();

app.post("/api/interview/start", (req, res) => {
  const sessionId = require("crypto").randomUUID();

  sessions.set(sessionId, {
    currentQuestionIndex: 0,
    answers: [],
    completed: false,
  });

  res.json({
    success: true,
    sessionId,
    question: questions[0],
    questionNumber: 1,
    totalQuestions: questions.length,
  });
});

app.post("/api/interview/answer", (req, res) => {
  const { sessionId, answer } = req.body;
  const session = sessions.get(sessionId);

  if (!session) {
    return res.status(404).json({
      success: false,
      message: "Interview session not found",
    });
  }

  if (session.completed) {
    return res.status(400).json({
      success: false,
      message: "Interview is already completed",
    });
  }

  if (typeof answer !== "string" || !answer.trim()) {
    return res.status(400).json({
      success: false,
      message: "Please provide an answer",
    });
  }

  session.answers.push({
    questionId: questions[session.currentQuestionIndex].id,
    answer: answer.trim(),
  });

  session.currentQuestionIndex++;

  if (session.currentQuestionIndex >= questions.length) {
    session.completed = true;

    return res.json({
      success: true,
      completed: true,
      message: "Interview completed",
      answers: session.answers,
    });
  }

  res.json({
    success: true,
    completed: false,
    question: questions[session.currentQuestionIndex],
    questionNumber: session.currentQuestionIndex + 1,
    totalQuestions: questions.length,
  });
});


app.get("/api/interview/:sessionId/report", (req, res) => {
  const { sessionId } = req.params;
  const session = sessions.get(sessionId);

  if (!session) {
    return res.status(404).json({
      success: false,
      message: "Interview session not found",
    });
  }

  if (!session.completed) {
    return res.status(400).json({
      success: false,
      message: "Interview is not completed yet",
    });
  }

  res.json({
    success: true,
    sessionId,
    completed: session.completed,
    totalQuestions: questions.length,
    answers: session.answers.map((item) => {
      const question = questions.find((q) => q.id === item.questionId);

      return {
        questionId: item.questionId,
        question: question?.text || "Question not found",
        category: question?.category || "unknown",
        answer: item.answer,
      };
    }),
    scoringStatus: "Pending approved rubric",
  });
});


const PORT = process.env.PORT || 5001;

app.listen(PORT, () => {
  console.log(`Server running on port ${PORT}`);
});
